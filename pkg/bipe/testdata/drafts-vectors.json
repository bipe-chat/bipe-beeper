    "ownUserId": "@ana:bipe.net.br",
    "joinedRoomIds": [
      "!chat:bipe.net.br",
      "!group:bipe.net.br"
    ]
  },
  "cases": [
    {
      "name": "a plain draft",
      "event": {
        "type": "m.room.message",
        "sender": "@ana:bipe.net.br",
        "content": {
          "msgtype": "m.text",
          "body": "Posso passar aí às 15h?",
          "chat.bipe.draft": {
            "room_id": "!chat:bipe.net.br",
            "client": "Claude Desktop"
          }
        }
      },
      "expected": {
        "show": true,
        "draft": {
          "roomId": "!chat:bipe.net.br",
          "body": "Posso passar aí às 15h?",
          "replyTo": null,
          "threadRoot": null,
          "client": "Claude Desktop"
        }
      }
    },
    {
      "name": "a reply in a thread",
      "event": {
        "type": "m.room.message",
        "sender": "@ana:bipe.net.br",
        "content": {
          "msgtype": "m.text",
          "body": "Posso passar aí às 15h?",
          "chat.bipe.draft": {
            "room_id": "!group:bipe.net.br",
            "client": "Claude Desktop",
            "reply_to": "$reply",
            "thread_root": "$root"
          }
        }
      },
      "expected": {
        "show": true,
        "draft": {
          "roomId": "!group:bipe.net.br",
          "body": "Posso passar aí às 15h?",
          "replyTo": "$reply",
          "threadRoot": "$root",
          "client": "Claude Desktop"
        }
      }
    },
