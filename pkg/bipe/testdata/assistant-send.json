{
  "$comment": "Generated by tools/gen-test-vectors.mjs from registries/mcp-tools.json personalSend. switch: assistantSendAllowed(content of the global account data chat.bipe.assistant_send); bipe-mcp sends only when allowed. label: assistantSender(message content); when not null the apps show bipe_app_assistant_sent_label with the sender's name. readers: assistantReaders(room state events); the apps show bipe_app_assistant_reads for each.",
  "switch": [
    {
      "name": "no account data",
      "content": null,
      "expected": false
    },
    {
      "name": "enabled true",
      "content": {
        "enabled": true
      },
      "expected": true
    },
    {
      "name": "enabled false",
      "content": {
        "enabled": false
      },
      "expected": false
    },
    {
      "name": "enabled as a string",
      "content": {
        "enabled": "true"
      },
      "expected": false
    },
    {
      "name": "enabled as a number",
      "content": {
        "enabled": 1
      },
      "expected": false
    },
    {
      "name": "an empty object",
      "content": {},
      "expected": false
    }
  ],
  "label": [
    {
      "name": "a plain message",
      "content": {
        "msgtype": "m.text",
        "body": "oi"
      },
      "expected": null
    },
    {
      "name": "sent by an assistant",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "Claude Desktop"
        }
      },
      "expected": "Claude Desktop"
    },
    {
      "name": "client name with spaces around it",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "  Cursor "
        }
      },
      "expected": "Cursor"
    },
    {
      "name": "a blank client name",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": " "
        }
      },
      "expected": null
    },
    {
      "name": "a marker that is not an object",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": "Claude"
      },
      "expected": null
    },
    {
      "name": "a client name over the limit",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
      },
      "expected": null
    }
  ],
  "readers": [
    {
      "name": "no marker",
      "events": [],
      "expected": []
    },
    {
      "name": "one reader",
      "events": [
        {
          "type": "chat.bipe.assistant",
          "state_key": "@ana:bipe.net.br",
          "sender": "@ana:bipe.net.br",
          "content": {
            "full_content": true
          }
        }
      ],
      "expected": [
        "@ana:bipe.net.br"
      ]
    },
    {
      "name": "turned off",
      "events": [
        {
          "type": "chat.bipe.assistant",
          "state_key": "@ana:bipe.net.br",
          "sender": "@ana:bipe.net.br",
          "content": {}
        }
      ],
      "expected": []
    },
    {
      "name": "set by someone else",
      "events": [
        {
          "type": "chat.bipe.assistant",
          "state_key": "@ana:bipe.net.br",
          "sender": "@bruno:bipe.net.br",
          "content": {
            "full_content": true
          }
        }
      ],
      "expected": []
    },
    {
      "name": "a string, not true",
      "events": [
        {
          "type": "chat.bipe.assistant",
          "state_key": "@ana:bipe.net.br",
          "sender": "@ana:bipe.net.br",
          "content": {
            "full_content": "true"
          }
        }
      ],
      "expected": []
    },
    {
      "name": "two readers, sorted",
      "events": [
        {
          "type": "chat.bipe.assistant",
          "state_key": "@bruno:bipe.net.br",
          "sender": "@bruno:bipe.net.br",
          "content": {
            "full_content": true
          }
        },
        {
          "type": "m.room.name",
          "state_key": "",
          "sender": "@ana:bipe.net.br",
          "content": {
            "name": "Grupo"
          }
        },
        {
          "type": "chat.bipe.assistant",
          "state_key": "@ana:bipe.net.br",
          "sender": "@ana:bipe.net.br",
          "content": {
            "full_content": true
          }
        }
      ],
      "expected": [
        "@ana:bipe.net.br",
        "@bruno:bipe.net.br"
      ]
    }
  ]
}
