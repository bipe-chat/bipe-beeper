      "name": "no account data",
      "content": null,
      "expected": false
    },
    {
      "name": "enabled true",
      "content": {
        "enabled": true
      },
      "expected": true
    },
    {
      "name": "enabled false",
      "content": {
        "enabled": false
      },
      "expected": false
    },
    {
      "name": "enabled as a string",
      "content": {
        "enabled": "true"
      },
      "expected": false
    },
    {
      "name": "enabled as a number",
      "content": {
        "enabled": 1
      },
      "expected": false
    },
    {
      "name": "an empty object",
      "content": {},
      "expected": false
    }
  ],
  "label": [
    {
      "name": "a plain message",
      "content": {
        "msgtype": "m.text",
        "body": "oi"
      },
      "expected": null
    },
    {
      "name": "sent by an assistant",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "Claude Desktop"
        }
      },
      "expected": "Claude Desktop"
    },
    {
      "name": "client name with spaces around it",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "  Cursor "
        }
      },
      "expected": "Cursor"
    },
    {
      "name": "a blank client name",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": " "
        }
      },
      "expected": null
    },
    {
      "name": "a marker that is not an object",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": "Claude"
      },
      "expected": null
    },
    {
      "name": "a client name over the limit",
      "content": {
        "msgtype": "m.text",
        "body": "oi",
        "chat.bipe.assistant": {
          "client": "ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
      },
      "expected": null
    }
  ]
